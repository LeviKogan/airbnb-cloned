DATABASE_URL="file:./dev.db"

# Public origin used in Stripe success/cancel links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js + Google OAuth
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAILS="owner@example.com"

# Stripe Checkout and webhook verification
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend transactional email
RESEND_API_KEY=""
BOOKING_EMAIL_FROM="Stay Victoria <bookings@yourdomain.com>"

# Optional local-only admin access for UI development. Never set in production.
AUTH_BYPASS_ADMIN="false"
