generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id          String   @id @default(cuid())
  propertyId  String
  checkIn     String
  checkOut    String
  guests      Int
  guestName   String
  guestEmail  String
  message     String?
  status      String
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

model PropertyOverride {
  id            String   @id @default(cuid())
  propertyId    String   @unique
  name          String
  location      String
  tagline       String
  description   String
  amenitiesJson String
  bedrooms      Int
  bathrooms     Int
  guests        Int
  pricePerNight Int
  featured      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model BlockedDateRange {
  id         String   @id @default(cuid())
  propertyId String
  checkIn    String
  checkOut   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([propertyId, checkIn, checkOut])
}
